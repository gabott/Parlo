{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlo.app/schemas/unit-content.schema.json",
  "title": "Parlo unit authoring document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_version", "course", "level", "unit", "lessons", "concepts", "lexemes", "phrases", "activities", "items", "media"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_version": { "type": "string", "pattern": "^[a-z0-9]+-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
    "course": { "$ref": "#/$defs/course" },
    "level": { "$ref": "#/$defs/level" },
    "unit": { "$ref": "#/$defs/unit" },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "lexemes": { "type": "array", "items": { "$ref": "#/$defs/lexeme" } },
    "phrases": { "type": "array", "items": { "$ref": "#/$defs/phrase" } },
    "activities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activity" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "media": { "type": "array", "items": { "$ref": "#/$defs/media" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "status": { "enum": ["draft", "in_review", "published", "retired"] },
    "localized": { "type": "object", "required": ["en"], "properties": { "en": { "type": "string", "minLength": 1 }, "fr": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "review": { "type": "object", "required": ["linguistic", "pedagogical", "accessibility"], "properties": { "linguistic": { "enum": ["pending", "approved", "rejected", "not_required"] }, "pedagogical": { "enum": ["pending", "approved", "rejected", "not_required"] }, "accessibility": { "enum": ["pending", "approved", "rejected", "not_required"] } }, "additionalProperties": false },
    "entity": { "type": "object", "required": ["id", "revision", "status", "review"], "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "status": { "$ref": "#/$defs/status" }, "review": { "$ref": "#/$defs/review" } } },
    "course": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["title", "description", "target_language", "support_locales", "level_ids"], "properties": { "title": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" }, "target_language": { "const": "fr" }, "support_locales": { "type": "array", "contains": { "const": "en" } }, "level_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } }] },
    "level": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["course_id", "cefr", "title", "description", "ordered_unit_ids"], "properties": { "course_id": { "$ref": "#/$defs/id" }, "cefr": { "enum": ["pre-a1", "a1", "a2", "b1", "b2", "c1", "c2"] }, "title": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" }, "ordered_unit_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } }] },
    "unit": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["level_id", "matrix_id", "title", "description", "capability", "prerequisite_unit_ids", "ordered_lesson_ids", "estimated_minutes", "content_role"], "properties": { "level_id": { "$ref": "#/$defs/id" }, "matrix_id": { "type": "string" }, "title": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" }, "capability": { "$ref": "#/$defs/localized" }, "prerequisite_unit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "ordered_lesson_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "estimated_minutes": { "type": "integer", "minimum": 1 }, "content_role": { "enum": ["required", "remedial", "review", "assessment", "enrichment", "reference"] } } }] },
    "lesson": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["unit_id", "matrix_id", "title", "objective", "prerequisite_lesson_ids", "concept_ids", "ordered_activity_ids", "estimated_minutes", "difficulty", "content_role"], "properties": { "unit_id": { "$ref": "#/$defs/id" }, "matrix_id": { "type": "string" }, "title": { "$ref": "#/$defs/localized" }, "objective": { "$ref": "#/$defs/localized" }, "prerequisite_lesson_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "concept_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "ordered_activity_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "estimated_minutes": { "type": "integer", "minimum": 1 }, "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }, "content_role": { "enum": ["required", "remedial", "review", "assessment", "enrichment", "reference"] } } }] },
    "concept": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["kind", "cefr", "title", "summary", "prerequisites"], "properties": { "kind": { "enum": ["grammar", "vocabulary_domain", "communicative_function", "pronunciation", "orthography", "culture_usage", "strategy"] }, "cefr": { "const": "a1" }, "title": { "$ref": "#/$defs/localized" }, "summary": { "$ref": "#/$defs/localized" }, "prerequisites": { "type": "array", "items": { "type": "object", "required": ["concept_id", "relationship"], "properties": { "concept_id": { "$ref": "#/$defs/id" }, "relationship": { "enum": ["required", "helpful"] } }, "additionalProperties": false } } } }] },
    "lexeme": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["lemma", "language", "part_of_speech", "cefr", "frequency_band", "senses", "concept_ids", "audio_ids"], "properties": { "lemma": { "type": "string", "minLength": 1 }, "language": { "const": "fr" }, "part_of_speech": { "enum": ["noun", "verb", "adjective", "adverb", "pronoun", "determiner", "preposition", "conjunction", "interjection", "number", "phrase"] }, "cefr": { "const": "a1" }, "frequency_band": { "enum": ["core", "frequent", "extended"] }, "senses": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "gloss", "register"], "properties": { "id": { "$ref": "#/$defs/id" }, "gloss": { "$ref": "#/$defs/localized" }, "register": { "enum": ["informal", "neutral", "formal"] } }, "additionalProperties": false } }, "concept_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "audio_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "phrase": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["french", "meaning", "function", "cefr", "concept_ids", "audio_ids"], "properties": { "french": { "type": "object", "required": ["text", "language", "variety", "register"], "properties": { "text": { "type": "string", "minLength": 1 }, "language": { "const": "fr" }, "variety": { "enum": ["neutral", "fr-FR", "fr-CA", "mixed"] }, "register": { "enum": ["informal", "neutral", "formal"] } }, "additionalProperties": false }, "meaning": { "$ref": "#/$defs/localized" }, "function": { "type": "string" }, "cefr": { "const": "a1" }, "concept_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "audio_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "activity": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["lesson_id", "kind", "content_role", "title", "instructions", "item_ids"], "properties": { "lesson_id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["presentation", "meaning_select", "audio_text_select", "sentence_build", "typed_recall", "guided_speaking", "mixed_review"] }, "content_role": { "enum": ["required", "remedial", "review", "assessment", "enrichment", "reference"] }, "title": { "$ref": "#/$defs/localized" }, "instructions": { "$ref": "#/$defs/localized" }, "body": { "$ref": "#/$defs/localized" }, "item_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "media_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "item": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["activity_kind", "cefr", "difficulty", "prompt", "concept_ids", "evidence_mode", "payload"], "properties": { "activity_kind": { "enum": ["meaning_select", "audio_text_select", "sentence_build", "typed_recall"] }, "cefr": { "const": "a1" }, "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }, "prompt": { "$ref": "#/$defs/localized" }, "concept_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidence_mode": { "enum": ["exposure", "recognition_supported", "recognition", "recall_supported", "recall", "transfer"] }, "payload": { "type": "object" } } }] },
    "media": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["kind", "uri", "mime_type"], "properties": { "kind": { "enum": ["audio", "image", "video"] }, "uri": { "type": "string", "minLength": 1 }, "mime_type": { "type": "string", "minLength": 1 }, "transcript": { "type": ["string", "null"] }, "accessibility_description": { "type": ["string", "null"] }, "captions_uri": { "type": ["string", "null"] } } }] }
  }
}
